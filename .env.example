# Copy to .env and fill in what you use; leave the rest out.

# The assistant's model (nuxt.config.ts): Vercel's AI Gateway with this key
# (billed), read when the server runs.
AI_GATEWAY_API_KEY=

# Nuxt Studio (/_studio): the GitLab OAuth application editors log in with
# (its callback: <address>/__nuxt_studio/auth/gitlab) and the secret of its
# session cookie.
STUDIO_GITLAB_APPLICATION_ID=
STUDIO_GITLAB_APPLICATION_SECRET=
NUXT_STUDIO_AUTH_SESSION_SECRET=

# The repository Studio commits to, when not eclipse-project-handbook in
# eclipsefdn/software-dev/websites on gitlab.eclipse.org, branch main.
STUDIO_REPOSITORY_REPO=
STUDIO_REPOSITORY_OWNER=
STUDIO_REPOSITORY_INSTANCE_URL=
STUDIO_REPOSITORY_BRANCH=

# Anyone logs in to /_studio as "Preview editor" without GitLab, publishing
# nothing (a merge request's preview): true.
STUDIO_PREVIEW_LOGIN=

# The site's address (canonical links, sitemap, feeds), once it has one.
SITE_URL=
